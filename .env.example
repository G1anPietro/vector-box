# --- Required (the Node server refuses to start without them) ---
SESSION_SECRET=change-me-to-a-long-random-string   # e.g. openssl rand -hex 32
ADMIN_PASSWORD=
GUEST_PASSWORD=

# --- Notifications (shared by Node and PHP). Use a NEW, unguessable topic ---
NTFY_TOPIC_URL=https://ntfy.sh/your-new-secret-topic

# --- Reverse proxy / network ---
# Proxies allowed to set X-Forwarded-For. PHP: comma-separated IPs. Node: "loopback", a hop count (1) or a CIDR.
TRUSTED_PROXIES=127.0.0.1,::1
TRUST_PROXY=loopback
NODE_ENV=production
COOKIE_SECURE=true

# --- Chat hub (optional): live chat over one Node SSE connection ---
# Leave empty to keep using the PHP stream (api/uplink_stream.php).
# CHAT_HUB_SECRET: shared by PHP and Node (e.g. openssl rand -hex 32).
# CHAT_STREAM_URL: what the BROWSER opens. Proxy it to Node's /api/chat/stream, e.g.
#   nginx:  location = /api/chat/stream { proxy_pass http://127.0.0.1:3000; proxy_buffering off; proxy_read_timeout 1h; }
# Never expose /internal/ through the proxy.
CHAT_HUB_SECRET=
CHAT_STREAM_URL=/api/chat/stream
# Where PHP pushes new messages (default: http://127.0.0.1:$PORT/internal/chat/publish)
# CHAT_HUB_INTERNAL_URL=
# Only if CHAT_STREAM_URL is on a different origin than the site (comma-separated)
# CHAT_STREAM_CORS_ORIGIN=

# --- Public STATUS window (optional) ---
# Services to show as UP/DOWN, checked with a TCP connect (cached 30s). Only the
# names are shown publicly, never host/port. Max 8. Example:
# STATUS_CHECKS=Minecraft=192.168.0.20:25565,Cloud=192.168.0.21:80
STATUS_CHECKS=

# --- Public address (link previews, sitemap) ---
# Also written out in public/robots.txt, public/.well-known/security.txt and the static game pages (pages/*.html): change them together.
SITE_URL=https://talvera.site

# --- Pi-hole numbers in the STATUS window (admin only) ---
# PIHOLE_URL: where Pi-hole's web/API answers from this server (e.g. http://127.0.0.1:8080).
# Pi-hole v6: PIHOLE_PASSWORD (an app password from Settings > Web interface/API). Pi-hole v5: PIHOLE_API_TOKEN.
PIHOLE_URL=
PIHOLE_PASSWORD=
PIHOLE_API_TOKEN=

# --- Content-Security-Policy ---
# Sent report-only (console warnings) until you set this to true.
CSP_ENFORCE=false

# --- Google AdSense (off while empty) ---
# Publisher id from AdSense (Account > Settings), e.g. ca-pub-1234567890123456.
# Ads appear only on pages/giochi.php and pages/ads.php (Support). Ad unit ids
# (Ads > By ad unit) are optional: without them only Auto ads can place ads.
# Also needed once you have the id: public/ads.txt (see docs/ADSENSE.md).
ADSENSE_CLIENT=
ADSENSE_SLOT_GAMES=
ADSENSE_SLOT_SUPPORT=

# Optional "Buy me a coffee" link (Ko-fi, Buy Me a Coffee, Liberapay…): button on Support and Games. Empty = hidden.
DONATE_URL=
# Optional second button (https://paypal.me/yourname) and a goal bar on pages/dona.php (update RAISED by hand)
DONATE_PAYPAL_URL=
DONATE_GOAL_TEXT=
DONATE_GOAL_EUR=
DONATE_RAISED_EUR=

# Optional contact address shown on pages/privacy.php (otherwise: the Uplink form).
CONTACT_EMAIL=

# --- E-mail (public/api/mailer.php): OFF while MAIL_DRIVER is empty ---
# MAIL_DRIVER=log   writes to data/mail.log (to try the box)        MAIL_DRIVER=http   POST to MAIL_HTTP_URL (Resend's JSON; other services need a small driver)
# The key goes ONLY here, never in the code or in chat. Send with bin/mail-worker.php every minute (cron); "Send now" in the box also works.
MAIL_DRIVER=
MAIL_FROM="vector-box <no-reply@your-domain>"
MAIL_HTTP_URL=
MAIL_API_KEY=
MAIL_DAILY_LIMIT=200

# --- Statistics map: country database (DB-IP Lite, CC BY 4.0), downloaded monthly by the daily retention job ---
# Nothing about visitors leaves the server. GEOIP_AUTO=false stops the download (then run tools/geoip-update.php by hand, or skip the map).
GEOIP_AUTO=true

# --- Visit notifications (public/api/visits.php) ---
# Each NEW visit (same IP + browser not seen for VISIT_GAP_MIN minutes) is written to
# data/visits.log and pushed to ntfy. Bots, the server itself and admins are not notified.
# VISIT_NTFY_URL defaults to NTFY_TOPIC_URL; VISIT_NOTIFY=false keeps only the log.
VISIT_NTFY_URL=
VISIT_NOTIFY=true
VISIT_GAP_MIN=30
VISIT_NOTIFY_MAX_PER_HOUR=20

# --- Class notes AI (bin/appunti-ai.php, run every 5 minutes as www-data) ---
# Gemini API key from Google AI Studio. New keys start with "AQ."; if Google refuses them in the
# x-goog-api-key header, set GEMINI_AUTH=bearer. Without a key the notes work, only the AI is off.
GEMINI_API_KEY=
GEMINI_AUTH=header
# "fast" = photo/PDF transcriptions and lesson documents; "smart" = test documents.
# Limits per minute/day as shown in AI Studio > Rate limit (the worker keeps 10% below the daily one).
# `php bin/appunti-ai.php --models` lists the model names your key can use.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_FAST_RPM=15
GEMINI_FAST_RPD=500
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_SMART_RPM=5
GEMINI_SMART_RPD=20
# Backup of the smart model when Google says it is overloaded (then the fast one)
GEMINI_MODEL_SMART2=gemini-3.7-flash
GEMINI_SMART2_RPM=5
GEMINI_SMART2_RPD=20
GEMINI_MODEL_SMART3=gemini-3.6-flash
GEMINI_SMART3_RPM=5
GEMINI_SMART3_RPD=20
# Seconds to wait before retrying a 500/503/504 ("high demand") answer, e.g. 2,5. Empty (the default) = no retries:
# every call counts against the day's free quota. The daily run never redoes a failed document; "Genera ora" does.
GEMINI_RETRY_WAITS=

# --- Audio recordings: Whisper on this server (bin/appunti-whisper.php, its own timer) ---
# When set, recordings of any size are transcribed here (free, offline) instead of by Gemini (max ~18 MB).
# The audio path is appended to the command. Model: "small" (default), "base" (faster), "medium" (better, slow).
WHISPER_CMD=
# WHISPER_CMD=/opt/vector-box-whisper/bin/python /var/www/vector-box/tools/whisper-transcribe.py
WHISPER_MODEL=small
WHISPER_MODELS_DIR=
WHISPER_TIMEOUT=10800

# --- Optional paths ---
PORT=3000
# Node listens on loopback only (behind nginx). 0.0.0.0 exposes it on every interface.
BIND_HOST=127.0.0.1
MC_DIR=/home/user/minecraft/minecraft_server
WAKE_SCRIPT=/home/user/bin/wakemainpc.sh

# The example class of the class notes (fake data, read-only for everybody, refreshed daily by the worker). false = do not create it.
DEMO_CLASS=true

# Data retention in days (api/retention.php runs once a day by itself; the privacy page prints these numbers). Defaults shown.
#RETENTION_VISITS_DAYS=90
#RETENTION_BOTS_DAYS=30
#RETENTION_IP_DAYS=90
#RETENTION_CHAT_DAYS=365
#RETENTION_DM_DAYS=365
#RETENTION_NOTIF_DAYS=180
#RETENTION_SHARE_DAYS=30

# News board: a script (tools/news.php --remote) may write to /api/news.php with this token (24+ random chars). Empty = only the admin in the browser.
NEWS_TOKEN=

# Optional: path of Calibre's ebook-convert (apt install calibre-bin). With it, MOBI, AZW3, FB2 and LIT uploads in the library are converted to EPUB.
# Without it those uploads are refused with a clear message. Usual paths (/usr/bin, /usr/local/bin) are found by themselves.
#EBOOK_CONVERT=/usr/bin/ebook-convert

# Personal mail (docs/POSTA.md): the domain of the addresses, and the secret the Cloudflare Worker uses to hand in incoming mail (empty = off)
MAIL_DOMAIN=talvera.site
MAIL_INBOUND_SECRET=
# Temporary public mailboxes (pages/tempmail.php): set to false to switch them off
TEMPMAIL=true
# Contact page (pages/contatti.php): the address people write to; default support@MAIL_DOMAIN. Make it in Mail -> Addresses.
SUPPORT_EMAIL=
