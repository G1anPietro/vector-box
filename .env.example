# --- Required (the Node server refuses to start without them) ---
SESSION_SECRET=change-me-to-a-long-random-string   # e.g. openssl rand -hex 32
ADMIN_PASSWORD=
GUEST_PASSWORD=

# --- Notifications (shared by Node and PHP). Use a NEW, unguessable topic ---
NTFY_TOPIC_URL=https://ntfy.sh/your-new-secret-topic

# --- Reverse proxy / network ---
# Proxies allowed to set X-Forwarded-For. PHP: comma-separated IPs. Node: "loopback", a hop count (1) or a CIDR.
TRUSTED_PROXIES=127.0.0.1,::1
TRUST_PROXY=loopback
NODE_ENV=production
COOKIE_SECURE=true

# --- Chat hub (optional): live chat over one Node SSE connection ---
# Leave empty to keep using the PHP stream (api/uplink_stream.php).
# CHAT_HUB_SECRET: shared by PHP and Node (e.g. openssl rand -hex 32).
# CHAT_STREAM_URL: what the BROWSER opens. Proxy it to Node's /api/chat/stream, e.g.
#   nginx:  location = /api/chat/stream { proxy_pass http://127.0.0.1:3000; proxy_buffering off; proxy_read_timeout 1h; }
# Never expose /internal/ through the proxy.
CHAT_HUB_SECRET=
CHAT_STREAM_URL=/api/chat/stream
# Where PHP pushes new messages (default: http://127.0.0.1:$PORT/internal/chat/publish)
# CHAT_HUB_INTERNAL_URL=
# Only if CHAT_STREAM_URL is on a different origin than the site (comma-separated)
# CHAT_STREAM_CORS_ORIGIN=

# --- Optional paths ---
PORT=3000
MC_DIR=/home/user/minecraft/minecraft_server
WAKE_SCRIPT=/home/user/bin/wakemainpc.sh
