# --- Required (the Node server refuses to start without them) ---
SESSION_SECRET=change-me-to-a-long-random-string   # e.g. openssl rand -hex 32
ADMIN_PASSWORD=
GUEST_PASSWORD=

# --- Notifications (shared by Node and PHP). Use a NEW, unguessable topic ---
NTFY_TOPIC_URL=https://ntfy.sh/your-new-secret-topic

# --- Reverse proxy / network ---
# Proxies allowed to set X-Forwarded-For. PHP: comma-separated IPs. Node: "loopback", a hop count (1) or a CIDR.
TRUSTED_PROXIES=127.0.0.1,::1
TRUST_PROXY=loopback
NODE_ENV=production
COOKIE_SECURE=true

# --- Chat hub (optional): live chat over one Node SSE connection ---
# Leave empty to keep using the PHP stream (api/uplink_stream.php).
# CHAT_HUB_SECRET: shared by PHP and Node (e.g. openssl rand -hex 32).
# CHAT_STREAM_URL: what the BROWSER opens. Proxy it to Node's /api/chat/stream, e.g.
#   nginx:  location = /api/chat/stream { proxy_pass http://127.0.0.1:3000; proxy_buffering off; proxy_read_timeout 1h; }
# Never expose /internal/ through the proxy.
CHAT_HUB_SECRET=
CHAT_STREAM_URL=/api/chat/stream
# Where PHP pushes new messages (default: http://127.0.0.1:$PORT/internal/chat/publish)
# CHAT_HUB_INTERNAL_URL=
# Only if CHAT_STREAM_URL is on a different origin than the site (comma-separated)
# CHAT_STREAM_CORS_ORIGIN=

# --- Public STATUS window (optional) ---
# Services to show as UP/DOWN, checked with a TCP connect (cached 30s). Only the
# names are shown publicly, never host/port. Max 8. Example:
# STATUS_CHECKS=Minecraft=192.168.0.20:25565,Cloud=192.168.0.21:80
STATUS_CHECKS=

# --- Public address (link previews, sitemap) ---
# Also written out in public/robots.txt and in the static game pages (pages/*.html): change them together.
SITE_URL=https://vector-box.duckdns.org

# --- Content-Security-Policy ---
# Sent report-only (console warnings) until you set this to true.
CSP_ENFORCE=false

# --- Google AdSense (off while empty) ---
# Publisher id from AdSense (Account > Settings), e.g. ca-pub-1234567890123456.
# Ads appear only on pages/giochi.php and pages/ads.php (Support). Ad unit ids
# (Ads > By ad unit) are optional: without them only Auto ads can place ads.
# Also needed once you have the id: public/ads.txt (see docs/ADSENSE.md).
ADSENSE_CLIENT=
ADSENSE_SLOT_GAMES=
ADSENSE_SLOT_SUPPORT=

# Optional "Buy me a coffee" link (Ko-fi, Buy Me a Coffee, Liberapay…): button on Support and Games. Empty = hidden.
DONATE_URL=

# Optional contact address shown on pages/privacy.php (otherwise: the Uplink form).
CONTACT_EMAIL=

# --- Visit notifications (public/api/visits.php) ---
# Each NEW visit (same IP + browser not seen for VISIT_GAP_MIN minutes) is written to
# data/visits.log and pushed to ntfy. Bots, the server itself and admins are not notified.
# VISIT_NTFY_URL defaults to NTFY_TOPIC_URL; VISIT_NOTIFY=false keeps only the log.
VISIT_NTFY_URL=
VISIT_NOTIFY=true
VISIT_GAP_MIN=30
VISIT_NOTIFY_MAX_PER_HOUR=20

# --- Optional paths ---
PORT=3000
# Node listens on loopback only (behind nginx). 0.0.0.0 exposes it on every interface.
BIND_HOST=127.0.0.1
MC_DIR=/home/user/minecraft/minecraft_server
WAKE_SCRIPT=/home/user/bin/wakemainpc.sh
